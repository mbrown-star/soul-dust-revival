{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "soul-dust-revival",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "soul-dust-revival"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2a924ce2874d45719269fa7d639b7b85"
    }
  ],
  // Workers Free gives 10ms of CPU time per request -- nowhere near enough
  // for @cf-wasm/photon's WASM decode+crop of a full KDP wrap cover, which
  // is what the cover-PDF upload actually hit in production ("Exceeded CPU
  // Limit"). The account was upgraded to Workers Paid specifically to allow
  // this; Paid defaults to 30s, configurable up to 300s (5 min). 60s gives
  // real headroom without going anywhere near that ceiling.
  "limits": {
    "cpu_ms": 60000
  },
  // The production Worker (souldustrevival.com, app.souldustrevival.com),
  // deployed with `--env production`. Same database and Supabase project as
  // staging, but its own Worker, secrets, and Hyperdrive config (caching
  // disabled from the start). Bindings aren't inherited by an environment,
  // so each one is repeated here. The sneak-peek switch is a build-time
  // NEXT_PUBLIC_LAUNCH_MODE, not a var -- see BUILD_TASKS.md.
  "env": {
    "production": {
      "name": "soul-dust-revival-prod",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "soul-dust-revival-prod"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "8279fc0c3ba24f2f99461f8b26fd61d1"
        }
      ]
    }
  }
}
