{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "soul-dust-revival",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "soul-dust-revival"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2a924ce2874d45719269fa7d639b7b85"
    }
  ]
  // A `limits.cpu_ms` override was tried here to fix the cover-PDF crop
  // hitting its CPU budget, but Cloudflare rejected the deploy outright:
  // "CPU limits are not supported for the Free plan." This account is
  // currently on Workers Free (10ms CPU/request), not Workers Paid (30s
  // default, configurable to 5 min) as CLAUDE.md's earlier entries assumed.
  // See the 2026-11-0x entry about the cover-PDF CPU limit for the decision
  // this is waiting on before it can be set.
}
