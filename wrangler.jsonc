{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "soul-dust-revival",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "soul-dust-revival"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2a924ce2874d45719269fa7d639b7b85"
    }
  ],
  // Workers Free gives 10ms of CPU time per request -- nowhere near enough
  // for @cf-wasm/photon's WASM decode+crop of a full KDP wrap cover, which
  // is what the cover-PDF upload actually hit in production ("Exceeded CPU
  // Limit"). The account was upgraded to Workers Paid specifically to allow
  // this; Paid defaults to 30s, configurable up to 300s (5 min). 60s gives
  // real headroom without going anywhere near that ceiling.
  "limits": {
    "cpu_ms": 60000
  }
}
