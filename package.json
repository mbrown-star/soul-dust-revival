{
  "name": "study-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-direct.mjs",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:seed": "tsx --env-file=.env.local qa/scripts/seed-qa.ts",
    "qa:cleanup": "tsx --env-file=.env.local qa/scripts/cleanup-qa.ts",
    "qa:dev": "node qa/scripts/qa-dev-server.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "npm run qa:seed && playwright test --project=chromium qa/e2e/specs/accessibility.spec.ts",
    "test:e2e:mobile": "npm run qa:seed && playwright test --project=mobile-chromium",
    "test:e2e:race": "npm run qa:seed && playwright test --project=mobile-webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report qa/playwright-report",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/s3-request-presigner": "^3.687.0",
    "@cf-wasm/photon": "^0.4.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.0",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "next": "^16.4.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "stripe": "^17.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 14",
    "not dead",
    "not IE 11"
  ]
}
