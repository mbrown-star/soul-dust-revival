# Copy to .env.local (or .env for production deploys) and fill in real values.
# Never commit the filled-in file — .env* is git-ignored except this one.
# Use separate credentials per environment (dev / staging / production).

# --- Database (Supabase Postgres via pooler, used by Drizzle) ---
# The real Supabase project -- shared by local `next dev` and the deployed
# site on purpose, so data entered in either place is the same data, with no
# separate "sync" step. lib/db/client.ts only adds TLS for a non-localhost
# host, so this can point at a local Postgres too if you ever want dev
# isolated from staging, but that is NOT the current/default setup.
DATABASE_URL=
# ALWAYS a local/disposable Postgres, never this project's real Supabase
# project -- e.g. postgresql://you@localhost:5432/soul_dust_revival_dev.
# npm test runs real inserts/deletes (this project has no mocked DB layer),
# and vitest.setup.ts forcibly overrides DATABASE_URL with this value for
# every test run, refusing to run at all if it's unset -- this is what keeps
# a test-cleanup bug from ever leaking into the shared dev/staging database
# again (it has happened twice; see CLAUDE.md's 2026-11-05 entries). Run
# `npm run db:generate && npm run db:migrate` against MIGRATION_DATABASE_URL
# pointed at this same local database once to set it up (see BUILD_TASKS.md
# "3. Database" for the one-time local Postgres setup steps).
TEST_DATABASE_URL=
# Session pooler or direct connection on the REAL Supabase project, used only
# by drizzle-kit (db:generate/db:migrate) -- migrations target the real
# project. The transaction pooler above hangs on DDL/advisory locks.
MIGRATION_DATABASE_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (use test-mode keys outside production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 (object storage) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional: the bucket's previous public address after moving it to a custom
# domain, so images stored under the old address keep loading.
R2_LEGACY_PUBLIC_BASE_URL=

# --- Cloudflare Stream (video) ---
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- X (Twitter) OAuth app, for social scheduling ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Meta (Facebook/Instagram) OAuth app, for social scheduling ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Internal secrets ---
# TOKEN_ENCRYPTION_KEY encrypts stored social OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# CRON_SECRET is the bearer token required by /api/cron/*. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Marketing/app subdomain split (optional, see lib/domains.ts) ---
# Leave all three unset (as in local dev) to keep the whole site on one
# domain, unchanged. Set all three together to turn on hostname-based
# routing: My Library/Study/Devotional/Account/Leader Resources redirect to
# NEXT_PUBLIC_APP_HOSTNAME, everything else redirects to
# NEXT_PUBLIC_MARKETING_HOSTNAME. NEXT_PUBLIC_* values are baked in at BUILD
# time by Next -- they must be real in .env.local when `npm run cf:deploy`'s
# build step runs, not set afterward via `wrangler secret put`.
NEXT_PUBLIC_MARKETING_HOSTNAME=
NEXT_PUBLIC_APP_HOSTNAME=
# Leading dot, e.g. .souldustrevival.com -- shares the Supabase auth session
# cookie across both hostnames so logging in on either authenticates both.
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Launch mode (optional, see lib/launchMode.ts) ---
# "sneak_peek" builds the limited pre-launch site: the homepage offers a free
# sample, and the store/cart/checkout are closed. Leave unset for the full
# site. Baked in at BUILD time like the other NEXT_PUBLIC_* values above.
NEXT_PUBLIC_LAUNCH_MODE=
