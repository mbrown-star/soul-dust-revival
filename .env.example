# Copy to .env.local (or .env for production deploys) and fill in real values.
# Never commit the filled-in file — .env* is git-ignored except this one.
# Use separate credentials per environment (dev / staging / production).

# --- Database (Supabase Postgres via pooler, used by Drizzle) ---
DATABASE_URL=
# Session pooler or direct connection, used only by drizzle-kit (db:generate/
# db:migrate). The transaction pooler above hangs on DDL/advisory locks.
MIGRATION_DATABASE_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (use test-mode keys outside production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 (object storage) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Cloudflare Stream (video) ---
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- X (Twitter) OAuth app, for social scheduling ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Meta (Facebook/Instagram) OAuth app, for social scheduling ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Internal secrets ---
# TOKEN_ENCRYPTION_KEY encrypts stored social OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# CRON_SECRET is the bearer token required by /api/cron/*. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
